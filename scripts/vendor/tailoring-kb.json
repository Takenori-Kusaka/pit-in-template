      "options": [
        {
          "id": "ai-free",
          "label": "制約なし"
        },
        {
          "id": "ai-approved-only",
          "label": "認可済みツールのみ"
        },
        {
          "id": "ai-unavailable",
          "label": "利用不可"
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "r-b-poc",
      "when": {
        "q-biz-phase": [
          "poc"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "gate",
            "id": "g-plan-approval"
          },
          "action": "simplify",
          "note": "企画承認は1枚企画書に簡略化する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-req-agree"
          },
          "action": "merge-into",
          "value": "g-spec-cycle",
          "note": "要件合意は省略し、仕様承認に統合する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "omit",
          "note": "独立レビューは省略する(捨てる前提のコードに人的レビューを投じない)"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "omit",
          "note": "出荷判定は省略する"
        },
        {
          "target": {
            "type": "practice",
            "id": "core-designation"
          },
          "action": "set",
          "param": "scope",
          "value": "none",
          "note": "コア指定はしない(全部使い捨て前提)"
        },
        {
          "target": {
            "type": "practice",
            "id": "debt-management"
          },
          "action": "set",
          "param": "mode",
          "value": "record-only",
          "note": "負債は記録のみ行い、返却しない"
        },
        {
          "target": {
            "type": "process"
          },
          "action": "note",
          "note": "PoC→MVP の切り替え時に「省略したゲートの復活とコア指定のやり直し」を企画承認の条件に含める"
        }
      ],
      "reason": "PoCの本質は捨てる前提で速く学ぶこと。ただし「PoCがそのまま本番化する事故」が最頻の失敗パターンのため、復活の条件をあらかじめ決めておく",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 10,
      "sourceFile": "rules-business-phase.yaml"
    },
    {
      "id": "r-b-mvp",
      "when": {
        "q-biz-phase": [
          "mvp"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "set",
          "param": "scope",
          "value": "core-only",
          "note": "独立レビューはコア機能のみ実施する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "simplify",
          "note": "出荷判定は簡略化する(記録は残す)"
        },
        {
          "target": {
            "type": "practice",
            "id": "core-designation"
          },
          "action": "set",
          "param": "scope",
          "value": "minimal",
          "note": "コア指定は最小限から始める"
        },
        {
          "target": {
            "type": "practice",
            "id": "debt-management"
          },
          "action": "set",
          "param": "mode",
          "value": "record-and-target",
          "note": "負債は記録し、返却の目安を持つ"
        }
      ],
      "reason": "最初の顧客がつく段階から、守るべき範囲(コア)を最小限で定義し始める",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 10,
      "sourceFile": "rules-business-phase.yaml"
    },
    {
      "id": "r-b-growth",
      "when": {
        "q-biz-phase": [
          "growth"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "practice",
            "id": "core-designation"
          },
          "action": "note",
          "note": "コア指定の範囲を事業の拡大に合わせて広げていく"
        },
        {
          "target": {
            "type": "practice",
            "id": "debt-management"
          },
          "action": "set",
          "param": "mode",
          "value": "planned-payback",
          "note": "負債の計画返却を開始する(返却枠の目安は容量の20%)"
        }
      ],
      "reason": "グロース期は参照モデルをほぼそのまま適用する段階。負債を返し始めないと拡大速度が落ちる",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 10,
      "sourceFile": "rules-business-phase.yaml"
    },
    {
      "id": "r-b-stable",
      "when": {
        "q-biz-phase": [
          "stable"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "strengthen",
          "note": "出荷判定を厳格化する(既存機能への変更影響の確認を強化)"
        },
        {
          "target": {
            "type": "practice",
            "id": "core-designation"
          },
          "action": "note",
          "note": "確定済みのコア指定を維持し、四半期で見直す"
        },
        {
          "target": {
            "type": "practice",
            "id": "debt-management"
          },
          "action": "set",
          "param": "mode",
          "value": "steady-cycle",
          "note": "負債返却を定常サイクルとして運用する"
        }
      ],
      "reason": "安定運用期は新規開発より変更影響の統制が重要になる",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 10,
      "sourceFile": "rules-business-phase.yaml"
    },
    {
      "id": "r-e-cl1",
      "when": {
        "q-criticality": [
          "cl1",
          "cl2",
          "cl3"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "practice",
            "id": "traceability"
          },
          "action": "set",
          "param": "required",
          "value": true,
          "note": "AI生成箇所の追跡(どこを生成し誰が承認したか)を必須にする"
        },
        {
          "target": {
            "type": "practice",
            "id": "ai-usage"
          },
          "action": "note",
          "note": "個人の権利・利益に影響する判定の設計は、AI単独で確定しない"
        }
      ],
      "reason": "回復可能であっても個人の権利に影響が及ぶ場合、判断の経路を後から再構成できる必要がある",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 50,
      "sourceFile": "rules-criticality.yaml"
    },
    {
      "id": "r-e-cl2",
      "when": {
        "q-criticality": [
          "cl2",
          "cl3"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "gate",
            "id": "g-plan-approval"
          },
          "action": "set",
          "param": "safetyRiskAssessment",
          "value": "required",
          "note": "安全リスクアセスメント(第6章 テンプレ9)を企画承認の前提条件にする"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "set",
          "param": "safetyVerificationRecord",
          "value": "required",
          "note": "安全適合性の検証記録(附属書F F.7)を出荷判定の判定基準に加える"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "set",
          "param": "independentSafetyAssessment",
          "value": true,
          "note": "独立レビューとは別に、実装の責任者から組織的に独立した安全性の評価を重ねる"
        },
        {
          "target": {
            "type": "process"
          },
          "action": "set",
          "param": "maxAutonomyLevel",
          "value": "L2",
          "note": "安全関連部のAI自律レベルはL2を上限とする"
        }
      ],
      "reason": "適合性評価または第三者認証の対象になる場合、危険源の同定から検証記録までの追跡が要求される",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/safety-verification/",
      "priority": 50,
      "sourceFile": "rules-criticality.yaml"
    },
    {
      "id": "r-e-cl3",
      "when": {
        "q-criticality": [
          "cl3"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "process"
          },
          "action": "set",
          "param": "maxAutonomyLevel",
          "value": "L1",
          "note": "安全関連部のAI自律レベルはL1に固定する。実績による引き上げの対象にしない"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "set",
          "param": "reviewerCount",
          "value": 2,
          "note": "独立レビューは2名で実施する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ci"
          },
          "action": "strengthen",
          "note": "故障挿入試験とミューテーション試験をCIの必須チェックに加える(附属書F F.4)"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "strengthen",
          "note": "出荷判定に、適用しなかった強く推奨される手法の理由の記載を求める"
        },
        {
          "target": {
            "type": "practice",
            "id": "ai-usage"
          },
          "action": "note",
          "note": "実装とテストを同一のAIに同一の文脈で書かせない。テスト生成の独立性は最強(組織的独立)を適用する"
        }
      ],
      "reason": "死亡または重篤な傷害が起こりうる場合、機能安全の枠組みが要求する独立性と検証の網を満たす必要がある",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/safety-verification/",
      "priority": 50,
      "sourceFile": "rules-criticality.yaml"
    },
    {
      "id": "r-d-outsourcer",
      "when": {
        "q-dev-form": [
          "outsourcer"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "role",
            "id": "value-owner"
          },
          "action": "set",
          "param": "location",
          "value": "client-side",
          "note": "価値責任者は発注側に置く(必須。提案書の最大の交渉点)"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-req-agree"
          },
          "action": "set",
          "param": "contractual",
          "value": true,
          "note": "要件合意を契約・検収の節目に対応づける"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-release"
          },
          "action": "set",
          "param": "contractual",
          "value": true,
          "note": "リリース判定を検収に対応づける"
        },
        {
          "target": {
            "type": "practice",
            "id": "acceptance"
          },
          "action": "note",
          "note": "検収対象を受入基準への適合に限定し、生成手段(人・AIの別)を問わないと契約に明記する"
        },
        {
          "target": {
            "type": "practice",
            "id": "core-understanding"
          },
          "action": "note",
          "note": "発注側にも理解保持者を置く(丸投げにしない)"
        }
      ],
      "reason": "発注側が価値の責任を持たない外注は、AI時代には「誰も中身を理解していないシステム」を最速で生む",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 20,
      "sourceFile": "rules-dev-form.yaml"
    },
    {
      "id": "r-d-vendor",
      "when": {
        "q-dev-form": [
          "vendor"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "role",
            "id": "value-owner"
          },
          "action": "note",
          "note": "受注側は価値責任者になれない(担えるのは機能責任者まで)。価値責任者を発注側に置くことを契約時に合意する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-req-agree"
          },
          "action": "set",
          "param": "contractual",
          "value": true,
          "note": "要件合意を多段階契約の節目に対応づける"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-release"
          },
          "action": "set",
          "param": "contractual",
          "value": true,
          "note": "リリース判定を検収に対応づける"
        },
        {
          "target": {
            "type": "practice",
            "id": "acceptance"
          },
          "action": "note",
          "note": "検収基準を受入基準への適合に限定する構成を発注側へ提案する(生成手段を問わない)"
        },
        {
          "target": {
            "type": "practice",
            "id": "handover"
          },
          "action": "note",
          "note": "引き継ぎ文書の粒度を契約で規定する(委託解消時の理解の空白を防ぐ)"
        }
      ],
      "reason": "AI生成コードの瑕疵担保責任は未整備の論点。検収を仕様適合に限定すれば既存の検収実務に載せられる",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 20,
      "sourceFile": "rules-dev-form.yaml"
    },
    {
      "id": "r-c-high",
      "when": {
        "q-quality": [
          "quality-high"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "gate",
            "id": "g-ci"
          },
          "action": "strengthen",
          "note": "CI基準を引き上げる(カバレッジ基準の強化)"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "set",
          "param": "coreReviewerCount",
          "value": 2,
          "note": "コア機能の独立レビューは2名で実施する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "strengthen",
          "note": "出荷判定に限定的な抜き取り確認を追加する"
        },
        {
          "target": {
            "type": "practice",
            "id": "ai-usage"
          },
          "action": "note",
          "note": "コア機能の設計判断はAI単独で行わない(人の判断を必須にする)"
        }
      ],
      "reason": "停止・誤動作が社会・金銭に影響する場合、検証の網を参照モデルより厚くする",
      "source": "https://takenori-kusaka.github.io/process-compass/phase4-process-design/tailoring-guide/",
      "priority": 30,
      "sourceFile": "rules-quality.yaml"
    },
    {
      "id": "r-c-regulated",
      "when": {
        "q-quality": [
          "quality-regulated"
        ]
      },
      "adjustments": [
        {
          "target": {
            "type": "gate",
            "id": "g-ci"
          },
          "action": "strengthen",
          "note": "CI基準を引き上げ、規制要件の自動チェックを追加する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "set",
          "param": "reviewerCount",
          "value": 2,
          "note": "独立レビューは2名で実施する"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-indep-review"
          },
          "action": "set",
          "param": "recordFormat",
          "value": "audit",
          "note": "レビュー記録は監査対応書式で残す"
        },
        {
          "target": {
            "type": "gate",
            "id": "g-ship"
          },
          "action": "strengthen",
