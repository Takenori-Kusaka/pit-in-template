# 依存関係
node_modules/
__pycache__/
.venv/
venv/
vendor/bin/

# ビルド成果物
dist/
build/
target/
*.egg-info/

# カバレッジの出力(G-5 の test ジョブが毎回作る。coverage-check が読む)
coverage/
.nyc_output/
coverage.json
coverage.out
# pytest-cov のデータファイル(追跡すると、カバレッジの判定が製品のファイルとして数える。process-compass #363)
.coverage
.coverage.*

# 出荷判定の証跡の作業領域(集約が毎回書く。ルート直下だけ)。docs/evidence/ は出荷の PR が保証の開示を置く記録の置き場であり、無視しない
/evidence/

# 秘匿情報。強制層の設定でも参照を遮断するが、混入の経路をここでも塞ぐ
.env
.env.*
!.env.example
*.pem
*.key

# エディタ・OS
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# 一時領域
tmp/
.cache/
*.log

# Graft のローカルグラフキャッシュ。再生成できるため commit しない(`graft build` で作る)
/graft/

# 自己修正ループのロック(scripts/gate/self-heal.mjs が作る。端末ごとの状態)
.claude/.self-heal

# 個人の作業環境に固有の指示。共有の指示資産へ混入させない(標準 第3章 3.11.5。G-5 の pr-rules が追跡を失敗にする。process-compass #358)
CLAUDE.local.md
**/CLAUDE.local.md
.claude/settings.local.json
**/.claude/settings.local.json
