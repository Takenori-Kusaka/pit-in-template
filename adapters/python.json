{
  "id": "python",
  "name": "Python",
  "runtime": "python",
  "runtimeVersion": "3.12",
  "commands": {
    "install": "python -m pip install --upgrade pip && pip install -e \".[dev]\"",
    "test": "pytest",
    "coverage": "pytest --cov --cov-report=json:coverage.json",
    "lint": "ruff check .",
    "audit": "pip-audit",
    "licenses": "pip-licenses --format=json | node scripts/gate/ip-clearance-python.mjs",
    "secretScan": "npx --yes -p secretlint@13.0.6 -p @secretlint/secretlint-rule-preset-recommend@13.0.6 secretlint \"**/*\""
  },
  "thresholdFiles": [".coveragerc", "pytest.ini", ".flake8", ".pylintrc", "pylintrc", "ruff.toml", ".ruff.toml", "mypy.ini", ".mypy.ini", ".bandit"],
  "coverageSummary": "coverage.json",
  "note": "coverage.json は pytest-cov の JSON 形式です。totals.percent_covered を読みます。thresholdFiles は、閾値・除外設定のファイル(禁止事項6。scripts/gate/check-pr.mjs が製品のコードとの同時変更を検査する)"
}
